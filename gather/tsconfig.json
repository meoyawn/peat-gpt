{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "lib": ["DOM", "ES2022"],
    "target": "ES2022",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/"],
  "exclude": ["node_modules/"]
}
