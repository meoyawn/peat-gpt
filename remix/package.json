{
  "name": "peat-gpt-front",
  "version": "0.0.1",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "bld": "remix build",
    "chk": "concurrently bun:chk:*",
    "chk:lint": "eslint app/ --fix",
    "chk:test": "bun test",
    "chk:types": "tsc",
    "clean": "rm -rf .cache/ functions/ public/build/",
    "deploy": "bun chk && bun clean && bun bld && bun pagesDeploy && say remix deployed",
    "dev": "remix dev -c \"bun run start\"",
    "pagesDeploy": "wrangler pages deploy ./public --commit-dirty=true --env production",
    "start": "wrangler pages dev --compatibility-date=2023-06-21 ./public",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@remix-run/cloudflare": "^1.18.1",
    "@remix-run/cloudflare-pages": "^1.18.1",
    "@remix-run/css-bundle": "^1.18.1",
    "@remix-run/react": "^1.18.1",
    "isbot": "^3.6.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.45.1",
    "rehype-external-links": "^2.1.0",
    "rehype-stringify": "^9.0.3",
    "remark-gfm": "^3.0.1",
    "remark-parse": "^10.0.2",
    "remark-rehype": "^10.1.0",
    "unified": "^10.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^3.19.0",
    "@remix-run/dev": "^1.18.1",
    "@remix-run/eslint-config": "^1.18.1",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.9",
    "@types/marked": "^5.0.0",
    "@types/react": "^18.0.35",
    "@types/react-dom": "^18.0.11",
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.2.0",
    "postcss": "^8.4.25",
    "tailwindcss": "^3.3.2",
    "wrangler": "^3.1.1"
  }
}
